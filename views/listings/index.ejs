<% layout("/layouts/boilerplate")%>
    <body>
        <h3>All Listings</h3>
        <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-3">
            <% for(listing of all_listings){ %>
                <a href="/listings/<%= listing._id%> " class="listing-link">
                <div class="card col listing-card" >
                    <img src="<%=listing.image.url%>" class="card-img-top" alt="listing Image" style="height: 20rem">
                    <div class="card-img-overlay">wanderlust</div>
                    <div class="card-body">
                        <p class="card-text">
                          <b>  <%= listing.title %></b><br />
                                &#8377;<%= listing.price.toLocaleString('en-IN') %>/night
                        </p>
                    </div>
                </div>
                </a>
                <% } %>
        </div>
    </body>