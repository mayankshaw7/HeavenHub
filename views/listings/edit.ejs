<% layout("/layouts/boilerplate")%>

<body>
  <!-- <h3>ADD new place </h3> -->
  <!-- <form method="post" action="/listings/new">
            Tile:<input placeholder="Enter the Title" name="title"><br><br>
            Description:<input placeholder="Enter the Description" name="description"><br><br>
            Image:<input placeholder="Enter the Image_url" name="image"><br><br>
            Price:<input placeholder="Enter the Price" name="price"><br><br>
            Country:<input placeholder="Enter the Country" name="country"><br><br>
            Location:<input placeholder="Enter the Location" name="place"><br><br>
            <button>Submit</button>
    </form> -->
  <br /><br />
  <div class="row">
    <div class="col-8 offset-2">
      <h3>Edit Place Details</h3>

      <form
        method="post"
        action="/listings/<%=listing._id%>?_method=PUT"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <div class="mb-3 mt-3">
          <label for="title" class="form-label">Title:</label>
          <input
            value="<%=listing.title %>"
            class="form-control"
            name="title"
            type="text"
            r
            required
          />
          <div class="valid-feedback">Title looks Good!</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description:</label>
          <input
            value="<%=listing.description %>"
            class="form-control"
            name="description"
            required
          />
          <div class="invalid-feedback">Please enter a short description</div>
        </div>
        <div class="mb-3">
          <label for="filename" class="form-label">Image Filename:</label>
          <input
            value="<%=listing.image.filename %>"
            class="form-control"
            name="filename"
            value="listingimage"
            required
          />
          <div class="invalid-feedback">Give name to image</div>
        </div>
        <div class="mb-3">
          <label for="url" class="form-label">Upload New Image</label>
          <input
            value="<%=listing.image.url %>"
            class="form-control"
            name="url"
            type="file"
            <!-- value="https://images.unsplash.com/photo-1571896349842-33c89424de2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8N3x8aG90ZWxzfGVufDB8fDB8fHww&auto=format&fit=crop&w=800&q=60" -->
            required
          />
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price:</label>
            <input
              value="<%=listing.price %>"
              class="form-control"
              name="price"
              min="0"
              required
            />
            <!-- type="number" -->
            <div class="invalid-feedback">Price should be valid</div>
          </div>
          <div class="mb-3 col-md-4">
            <label for="country" class="form-label">Country:</label>
            <input
              value="<%=listing.country %>"
              class="form-control"
              name="country"
              required
            />
            <div class="invalid-feedback">Please enter valid Country</div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location:</label>
          <input
            value="<%=listing.location %>"
            class="form-control"
            name="location"
            required
          />
          <div class="invalid-feedback">Please enter valid location</div>
        </div>

        <button class="btn btn-dark edit-btn mt-3">Edit</button><br /><br />
      </form>
    </div>
  </div>
</body>
